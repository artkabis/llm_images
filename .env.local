# =============================================================
# MODE DEV LOCAL — Sans Docker
# Copier : cp .env.local .env
# Redis seul peut tourner via : docker run -d -p 6379:6379 redis:7-alpine
# ou via : brew install redis && redis-server (macOS)
# ou via : sudo apt install redis && redis-server (Ubuntu)
# =============================================================

APP_ENV=development
APP_SECRET_KEY=dev-secret-key-change-in-production-32chars
APP_DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:3000

JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-32c
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite local (créé automatiquement au démarrage)
DATABASE_URL=sqlite+aiosqlite:///./facerec.db

# Redis local (localhost au lieu du nom Docker)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# ML service sur localhost
ML_SERVICE_URL=http://localhost:8001
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_CTX_ID=-1          # -1 = CPU (pas besoin de GPU pour tester)
ML_THRESHOLD_AUTHORIZED=0.85
ML_THRESHOLD_SUSPECT=0.70
ML_INFERENCE_TIMEOUT_MS=500    # Plus tolérant en mode dev
ML_ACTIVE_LEARNING_TRIGGER=5   # Seuil bas pour tester rapidement
ML_DRIFT_ALERT_THRESHOLD=0.05

FAISS_INDEX_PATH=./data/faiss/index.faiss
FAISS_TOP_K=5

DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
DATA_ACTIVE_LEARNING_PATH=./data/active_learning
SECURE_FRAMES_PATH=./data/secure_frames
AUDIT_LOGS_PATH=./data/audit_logs

ENCRYPTION_KEY=dev00000000000000000000000000000

# MLflow local
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=facial-recognition-dev

CAMERAS_CONFIG=./config/cameras.yml

NOTIFY_MIN_LEVEL=WARNING
NOTIFY_EMAIL_ENABLED=false
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=

RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_AUTH_FAILURES=50

LOG_LEVEL=DEBUG
PROMETHEUS_PORT=9000

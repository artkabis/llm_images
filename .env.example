# =============================================================
# FACIAL RECOGNITION SYSTEM — Configuration
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# =============================================================

# --- Application ---
APP_ENV=development            # development | production
APP_SECRET_KEY=changeme-generate-a-strong-random-key-here
APP_DEBUG=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:3000

# --- JWT ---
JWT_SECRET_KEY=changeme-generate-another-strong-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Base de données ---
DATABASE_URL=sqlite:////data/db/facerec.db
# Pour PostgreSQL (phase 2) :
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/facerec

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# --- ML / InsightFace ---
INSIGHTFACE_MODEL=buffalo_l          # buffalo_l | buffalo_s (plus léger)
INSIGHTFACE_CTX_ID=0                 # 0=GPU, -1=CPU
ML_THRESHOLD_AUTHORIZED=0.85         # Score minimum pour "autorisé"
ML_THRESHOLD_SUSPECT=0.70            # Score minimum pour "suspect"
ML_INFERENCE_TIMEOUT_MS=200
ML_ACTIVE_LEARNING_TRIGGER=50        # Nb labels avant fine-tuning auto
ML_DRIFT_ALERT_THRESHOLD=0.05        # Dérive de 5% déclenche une alerte

# --- FAISS ---
FAISS_INDEX_PATH=/data/faiss/index.faiss
FAISS_TOP_K=5

# --- Stockage des données ---
DATA_RAW_PATH=/data/raw
DATA_PROCESSED_PATH=/data/processed
DATA_ACTIVE_LEARNING_PATH=/data/active_learning
SECURE_FRAMES_PATH=/data/secure_frames
AUDIT_LOGS_PATH=/data/audit_logs

# --- Chiffrement (AES-256) ---
ENCRYPTION_KEY=changeme-32-bytes-hex-key-here

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=facial-recognition

# --- Caméras (liste JSON) ---
CAMERAS_CONFIG=/config/cameras.yml

# --- Notifications ---
NOTIFY_MIN_LEVEL=ALERT              # INFO | WARNING | ALERT | CRITICAL
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_HOST=smtp.example.com
NOTIFY_EMAIL_PORT=587
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_RECIPIENTS=security@example.com
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=

# --- Monitoring ---
PROMETHEUS_PORT=9000
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AUTH_FAILURES=10          # Max tentatives avant blacklist IP

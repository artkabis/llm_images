# =============================================================
# DÉVELOPPEMENT LOCAL — Clés temporaires (NE PAS utiliser en production)
# Copier ce fichier : cp .env.dev .env
# =============================================================

APP_ENV=development
APP_SECRET_KEY=dev-secret-key-change-in-production-32chars
APP_DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:80

JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-32c
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite+aiosqlite:////data/db/facerec.db

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

ML_SERVICE_URL=http://ml:8001
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_CTX_ID=-1
ML_THRESHOLD_AUTHORIZED=0.85
ML_THRESHOLD_SUSPECT=0.70
ML_INFERENCE_TIMEOUT_MS=200
ML_ACTIVE_LEARNING_TRIGGER=10
ML_DRIFT_ALERT_THRESHOLD=0.05

FAISS_INDEX_PATH=/data/faiss/index.faiss
FAISS_TOP_K=5

DATA_RAW_PATH=/data/raw
DATA_PROCESSED_PATH=/data/processed
DATA_ACTIVE_LEARNING_PATH=/data/active_learning
SECURE_FRAMES_PATH=/data/secure_frames
AUDIT_LOGS_PATH=/data/audit_logs

ENCRYPTION_KEY=dev00000000000000000000000000000

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=facial-recognition-dev

CAMERAS_CONFIG=/config/cameras.yml

NOTIFY_MIN_LEVEL=WARNING
NOTIFY_EMAIL_ENABLED=false
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=

RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_AUTH_FAILURES=50

GRAFANA_ADMIN_PASSWORD=admin

LOG_LEVEL=DEBUG
PROMETHEUS_PORT=9000
